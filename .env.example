# Environment variables consumed by spdotdev/scuttle-dev.
#
# This package is a Laravel library, not a standalone app, it has no .env
# of its own. Copy the lines below into the *host application's* .env so the
# package works as soon as it's installed. Every variable already has a safe
# default (see config/scuttle-dev.php), so omitting this file entirely will
# NOT break the install; it only lets you override the defaults.
# README.md lists the same variables with their defaults.

# Host this package answers on. Defaults to "scuttle.dev" if unset.
# Set this to a local/staging host (e.g. localhost) when verifying the
# package outside of production.
SCUTTLE_DOMAIN=scuttle.dev
# The booking page behind every "Book a call" button.
SCUTTLE_BOOKING_URL=https://plan.scuttle.dev/book/stas
# Contact form: delivery address.
SCUTTLE_CONTACT_TO=info@scuttle.dev
# Contact form: its own mailer, for a host whose default mailer is "log".
# A Symfony mailer DSN and the address it sends from. Keep both out of the repository.
SCUTTLE_CONTACT_MAIL_DSN=
SCUTTLE_CONTACT_MAIL_FROM=
# The form refuses to say "Sent" when the default mailer is log or array. Set false only in tests.
SCUTTLE_REQUIRE_REAL_MAILER=true
# Cloudflare Turnstile keys (optional; without keys the form uses a honeypot
# and a signed minimum fill time instead).
SCUTTLE_TURNSTILE_SITE_KEY=
SCUTTLE_TURNSTILE_SECRET=
# Google Analytics measurement id (optional). Loaded only after the visitor agrees in the cookie banner.
SCUTTLE_GA_ID=
# Site key in sd-analytics, the cookieless own counting (optional). Empty: no counting.
SCUTTLE_ANALYTICS_KEY=

# Free DB-IP Lite country file (https://db-ip.com/db/lite.php, CC BY 4.0). Empty: no IP country.
SCUTTLE_GEOIP_DB=
